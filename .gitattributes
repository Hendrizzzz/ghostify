# Normalize text files to LF in the repository and in every checkout so
# formatting checks, ZIP packaging, and generated-bundle drift checks behave
# the same on Windows, macOS, and Linux.
* text=auto eol=lf

# Windows PowerShell scripts keep CRLF, matching .editorconfig.
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.webm binary
*.zip binary

# Generated by build.js from src/; collapsed in GitHub diffs.
dist/background.js linguist-generated=true
dist/js/content.js linguist-generated=true
dist/js/ghost.js linguist-generated=true
dist/js/messenger_patch.js linguist-generated=true
