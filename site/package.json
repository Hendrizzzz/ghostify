{
  "name": "ghostify-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "audit:high": "npm audit --audit-level=high",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "build": "tsc --noEmit && vite build",
    "dev": "vite"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lucide-react": "1.34.0",
    "motion": "^13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "8.2.2"
  }
}
